# ---------------------------------------------------------------------------
# Reason: .env holds every credential (POSTGRES_PASSWORD, POLARIS_SECRET,
# API_KEY, MINIO_ROOT_PASSWORD...). NEVER push it to git.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# temporary venv used to verify vnstock — not part of the stack, safe to delete any time
.scratch_vnstock/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Claude Code: per-machine personal settings (keep the shared settings.json if any)
.claude/settings.local.json

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local logs
*.log
