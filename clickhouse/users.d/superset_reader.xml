<!-- Read-only user Superset connects with: SELECT on the gold database only. The admin user
     (dbt) is created by the image from CLICKHOUSE_USER / CLICKHOUSE_PASSWORD. -->
<clickhouse>
    <users>
        <superset_reader>
            <password from_env="SUPERSET_READER_PASSWORD"/>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT ON gold.*</query>
            </grants>
        </superset_reader>
    </users>
</clickhouse>
