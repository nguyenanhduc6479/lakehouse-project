# Template for .env — every credential and tunable of the stack. Copy it and fill in the secrets:
#   cp .env.example .env
# .env is gitignored; this file is committed, so it must never contain real secrets.
# Values marked "change-me" are secrets: use your own. Generate random ones with
#   openssl rand -hex 32
# POSTGRES_* / SOURCE_POSTGRES_* / *_ADMIN_* only take effect when a database volume is first
# initialised: after changing them, recreate the volumes (docker compose down -v).

# --- data-platform database (shared `postgres` instance, host port 5432) ---
# superuser of the instance; its default DB holds silver / staging
POSTGRES_DB=data-platform
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
# service name inside the Docker network (used by postgres-setup)
POSTGRES_HOST=postgres

# --- airflow ---
# database + role created by postgres-setup; the same password is the web UI admin's
POSTGRES_DB_AIRFLOW=airflow
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=change-me
# web UI admin login (http://localhost:8085), created by airflow-init
AIRFLOW_ADMIN_USER=airflow
# shared by webserver and scheduler (otherwise the UI gets 403 reading task logs): openssl rand -hex 32
AIRFLOW_WEBSERVER_SECRET_KEY=change-me
# encrypts connection passwords in the Airflow DB; must be a Fernet key:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change-me

# --- polaris (Iceberg REST catalog) ---
# database + role created by postgres-setup (Polaris persistence)
POSTGRES_DB_POLARIS=polaris
POLARIS_ADMIN_USERNAME=polaris
POLARIS_ADMIN_PASSWORD=change-me
# client secret of the `root` principal (OAuth2 client credentials for Trino, Spark, the sink)
POLARIS_SECRET=change-me
# Polaris signs OAuth2 tokens with this fixed HMAC key, so tokens stay valid across Polaris restarts
# (the default RSA key pair is regenerated at every start). Changing it invalidates every issued
# token: then restart the sink task and Trino (docs/services.md). openssl rand -hex 32
POLARIS_TOKEN_SIGNING_KEY=change-me

# --- object storage: RustFS (S3-compatible) ---
# also the RustFS console login (http://localhost:9001/rustfs/console/); secret key >= 8 characters
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_ENDPOINT=http://rustfs:9000
S3_BUCKET=data-platform
# RustFS ignores the region, but every AWS SDK client (Polaris, Spark, Trino) requires one
S3_REGION=us-east-1

# --- spark-worker resources ---
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=3G

# --- timezone (TZ of every long-running service; also Postgres' `timezone` at initdb) ---
TZ=Asia/Ho_Chi_Minh

# --- grafana admin account (http://localhost:3000) ---
GRAFANA_ADMIN_USER=grafana
GRAFANA_ADMIN_PASSWORD=change-me

# --- source-db (CDC source, host port 5433) ---
SOURCE_POSTGRES_DB=source-db
SOURCE_POSTGRES_USER=admin
SOURCE_POSTGRES_PASSWORD=change-me
# login of the `debezium` replication role (created by source/schema.sql via source-db-setup)
SOURCE_POSTGRES_DB_DEBEZIUM_PASSWORD=change-me

# --- data generator (service `generator`, profile "generator") ---
# events per second written into source-db
GENERATOR_RATE=2

# --- clickhouse (gold) ---
# password of the ClickHouse user `admin` (created by the image; dbt writes gold with it)
CLICKHOUSE_ADMIN_PASSWORD=change-me
# password of the Postgres role `clickhouse_reader` (read-only on silver, created by postgres-setup);
# ClickHouse reads silver with it through the named collection `silver_pg`
CLICKHOUSE_READER_PASSWORD=change-me
# password of the ClickHouse user `superset_reader` (read-only on gold.*), used by Superset
SUPERSET_READER_PASSWORD=change-me

# --- superset (dashboards, http://localhost:8088) ---
# signs sessions and encrypts stored DB passwords: openssl rand -hex 32
SUPERSET_SECRET_KEY=change-me
# web UI admin login, ensured by superset/scripts/init.sh at every start
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me
